{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Personal Finance (Development - Debug)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--dart-define=APP_ENV=development"
      ]
    },
    {
      "name": "Personal Finance (Production - Debug)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--dart-define=APP_ENV=production"
      ]
    },
    {
      "name": "Personal Finance (Production - Release)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "release",
      "args": [
        "--dart-define=APP_ENV=production"
      ]
    }
  ]
}
