rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Deny everything by default ──────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // ── User data ────────────────────────────────────────────────────────────
    // Each user owns their sub-tree. No other authenticated user can cross it.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // ── Transactions ──────────────────────────────────────────────────────
      match /transactions/{transactionId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
                      && isValidTransaction(request.resource.data);

        allow update: if isOwner(userId)
                      && isValidTransaction(request.resource.data)
                      // userId field must never change after creation
                      && request.resource.data.userId == resource.data.userId;

        // Hard deletes are rejected; the app uses soft-delete (deletedAt field).
        allow delete: if false;
      }
    }

    // ── Helper functions ─────────────────────────────────────────────────────

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['userId', 'amount', 'type', 'description', 'date'])
          && data.userId is string
          && data.amount is number
          && data.amount > 0
          && data.type in ['income', 'expense']
          && data.description is string
          && data.description.size() <= 500
          // date may arrive as a Firestore Timestamp or an ISO8601 string
          && (data.date is timestamp || data.date is string);
    }
  }
}
