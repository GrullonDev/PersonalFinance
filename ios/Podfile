# Uncomment this line to define a global platform for your project
platform :ios, '16.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      # iOS deployment target consistente con Runner (16.0).
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'

      # PARCHE PARA RECURSOS / BUNDLES DE PRIVACIDAD
      # Algunos pods (Firebase, GoogleSignIn, MLKit) generan sub-bundles de
      # recursos (.bundle) que Xcode intenta firmar individualmente y falla
      # con "code signing requires development team". Esto los exime.
      if target.respond_to?(:product_type) && target.product_type == 'com.apple.product-type.bundle'
        config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
        config.build_settings['CODE_SIGNING_REQUIRED'] = 'NO'
      end
    end
  end

  # NOTA: previamente había un segundo bloque que iteraba
  # `installer.aggregate_targets` y llamaba `config_obj.attributes[...]`.
  # Eso funcionaba en CocoaPods <= 1.15 porque `user_build_configurations`
  # devolvía objetos. Desde CocoaPods 1.16 devuelve un Hash
  # `{ "Release" => :release, ... }` (los valores son Symbols), por lo que
  # llamar `.attributes` lanza "undefined method 'attributes' for an
  # instance of Symbol" y rompe `pod install`.
  #
  # El propósito original era forzar CODE_SIGNING_REQUIRED/ALLOWED = YES en
  # Release/Profile para los aggregate targets de Pods, pero eso ya es el
  # default de Xcode y Automatic Signing lo respeta. Eliminar el parche
  # devuelve `pod install` a un estado funcional sin efectos colaterales.
end
