<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ───────────────────────── Bundle / Identidad ───────────────────────── -->
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Personal Finance</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>personal_finance</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>

	<!-- Idiomas soportados (ES/EN). Mejora presentación en App Store. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>es</string>
	</array>

	<!-- ───────────────────────── Google Sign-In ─────────────────────────────
	     CLIENT_ID y REVERSED_CLIENT_ID del proyecto `personalfinancedev-e972f`,
	     bundle `com.grullondev.personalFinance`. Sincronizados con
	     ios/Runner/GoogleService-Info.plist. Si regeneras GoogleService-Info.plist
	     actualiza también GIDClientID y CFBundleURLSchemes de este archivo. -->
	<key>GIDClientID</key>
	<string>116411792004-ockrenvueh05dn5l54rvdjphh4hjj7el.apps.googleusercontent.com</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>GoogleSignIn</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.116411792004-ockrenvueh05dn5l54rvdjphh4hjj7el</string>
			</array>
		</dict>
	</array>

	<!-- Required for Flutter wireless debugging (Dart VM Service discovery via mDNS) -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Se requiere acceso a la red local para la depuración de desarrollo.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_dart._tcp</string>
		<string>_dartobservatory._tcp</string>
	</array>

	<!-- ───────────────────────── Export Compliance ─────────────────────────
	     La app sólo usa HTTPS estándar (sin algoritmos criptográficos
	     propietarios). Declararlo aquí evita tener que responder a la pregunta
	     de exportación en cada submit. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- ───────────────────────── Permisos / Privacy Strings ───────────────── -->
	<key>NSFaceIDUsageDescription</key>
	<string>Se usa Face ID / Touch ID para desbloquear la app y proteger tu información financiera.</string>
	<key>NSCameraUsageDescription</key>
	<string>Se utiliza la cámara para capturar recibos y guardarlos junto a tus movimientos.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Se accede a la galería para adjuntar recibos o tu foto de perfil.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Se guardan reportes o comprobantes exportados en tu galería cuando lo solicitas.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>El acceso al micrófono es solo para grabaciones opcionales adjuntas a una transacción.</string>

	<!-- ───────────────────────── Plataforma iOS ───────────────────────────── -->
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>

	<!-- Portrait-only para una experiencia móvil consistente de finanzas. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!--
	NOTA: NO declaramos `UIApplicationSceneManifest`. El template estándar de
	Flutter usa `UIMainStoryboardFile = Main` (App lifecycle clásico) y deja que
	`FlutterAppDelegate` cree el `FlutterViewController` desde Main.storyboard.
	`FlutterSceneDelegate` solo existe en versiones muy recientes del framework
	y declararlo cuando no está disponible deja a iOS sin escena para presentar:
	resultado = launch screen blanco indefinido y ningún log de Flutter.
	-->
</dict>
</plist>
